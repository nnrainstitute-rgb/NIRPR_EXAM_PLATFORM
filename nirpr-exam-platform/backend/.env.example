# Copy this file to ".env" (same folder as main.py) and fill in your values.
# Lines starting with # are comments and are ignored.
# .env is loaded automatically when you run "python seed.py" or
# "uvicorn main:app" — you do NOT need to set these in PowerShell/CMD manually.

# Set this only after migrating into a new, empty PostgreSQL database.
# URL-encode special characters in the password.
# DATABASE_URL=postgresql+asyncpg://nirpr_user:YOUR_PASSWORD@localhost:5432/nirpr_exam

# --------------------------------------------------------------------------
# Email (SMTP) — required to actually send verification / reset / credential
# emails. If left blank, emails are written to outbox/*.html on disk instead
# so you can still test the flow without a mail server.
# --------------------------------------------------------------------------

# Example values for Gmail (see README for the full walkthrough):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=youraddress@gmail.com
# SMTP_PASSWORD=your-16-character-app-password
# SMTP_USE_TLS=true
# SMTP_FROM=youraddress@gmail.com
# SMTP_FROM_NAME=NIRPR RSO Examination Platform

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=
SMTP_FROM_NAME=NIRPR RSO Examination Platform

# Railway deployment: mount a persistent volume at /data for uploaded files.
# SMTP requires Railway Pro or above. Configure these in Railway Variables.
# APP_ENV=production
# UPLOAD_DIR=/data/uploads
# DB_POOL_MODE=null
# REDIS_URL=
# ALLOWED_ORIGINS=https://your-app.up.railway.app
# RECAPTCHA_SITE_KEY=your-real-v2-site-key
# RECAPTCHA_SECRET_KEY=your-real-v2-secret-key
# RECAPTCHA_ALLOWED_HOSTNAMES=your-app.up.railway.app

# The base URL used to build links inside emails (verification, reset links).
# Change this to your real domain once deployed, e.g. https://exams.nirpr.gov.ng
APP_BASE_URL=http://localhost:8000

# --------------------------------------------------------------------------
# App / security
# --------------------------------------------------------------------------

# Random signing key for login sessions — set a long random value in production.
# You can generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string-in-production

# How long a login session lasts before the candidate/staff member has to
# log in again.
ACCESS_TOKEN_EXPIRE_MINUTES=480

# How long the emailed "verify your email" link stays valid before the
# candidate has to request a new one.
VERIFICATION_TOKEN_EXPIRE_HOURS=24

# How long the emailed "reset your password" link stays valid.
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60

# --------------------------------------------------------------------------
# Seeded accounts (only used the first time you run "python seed.py")
# --------------------------------------------------------------------------
ADMIN_EMAIL=admin@nirpr.gov.ng
ADMIN_PASSWORD=ChangeMe#2026
EXAMINER_EMAIL=examiner@nirpr.gov.ng
EXAMINER_PASSWORD=Examiner#2026
